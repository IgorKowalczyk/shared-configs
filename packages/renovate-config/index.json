{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "dependencyDashboard": false,
  "labels": ["dependencies"],
  "reviewers": ["igorkowalczyk"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "minimumReleaseAge": "1 day",
  "prFooter": "",
  "prBodyTemplate": "{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}",
  "packageRules": [
    {
      "matchPackagePatterns": ["contentlayer"],
      "groupName": "contentlayer"
    },
    {
      "matchPackageNames": ["@udecode"],
      "groupName": "@udecode/plate"
    },
    {
      "description": "Disable non-major updates globally",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest", "lockFileMaintenance", "rollback", "bump"],
      "enabled": false
    },
    {
      "description": "Allow major updates",
      "matchUpdateTypes": ["major"],
      "enabled": true
    }
  ]
}
